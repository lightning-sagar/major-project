# Copy to .env and adjust. Everything is optional for local use.

# Port the site is served on: http://localhost:8080
WEB_PORT=8080

# Change these for anything other than local testing
JWT_SECRET=local-dev-jwt-secret-change-me
SESSION_SECRET=local-dev-session-secret-change-me
JWT_EXPIRES_IN=7d

# Google sign-in (leave blank to use email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Comma-separated emails that get the admin panel
VITE_ADMIN_EMAILS=

# First compile of each board core can be slow under Rosetta
COMPILE_TIMEOUT_MS=600000
